/**
 * ESP8266 ESP-01 hodiny a firmware pre počasie
 *
 * Tento firmware používa OLED displej SSD1306 128x64 na striedavé zobrazovanie:
 * - Obrazovka hodín: deň v týždni, aktuálny čas (HH:MM), dátum
 *
 * Konfigurácia Wi-Fi:
 * Ak nie je nájdená konfigurácia alebo je pri štarte podržané tlačidlo na GPIO3,
 * zariadenie sa spustí ako Access Point (SSID: ESP01-Setup) a zobrazí
 * konfiguračnú web stránku.
 * Stránka umožňuje nastaviť Wi-Fi SSID, heslo, mesto pre počasie a časové pásmo.
 * Nastavenia sa uložia do EEPROM a zariadenie sa reštartuje.
 *
 * Bežná prevádzka:
 * Pripojí sa k Wi-Fi, synchronizuje čas cez NTP (každých 60 s).
 * Získa počasie zo servera wttr.in (HTTPS GET).
 * Zobrazuje čas a počasie na OLED, obrazovky sa prepínajú každých 15 sekúnd.
 *
 * Hardvér:
 * - ESP8266 ESP-01 (GPIO0=SDA, GPIO2=SCL pre I2C OLED; GPIO3 ako vstup pre tlačidlo)
 * - OLED displej SSD1306 128x64 cez I2C (adresa 0x3C)
 *
 * Poznámka: Používa vlastné fonty (FreeMonoBold18pt7b pre čas,
 * FreeMonoBold12pt7b pre teplotu).
 * Ostatný text používa predvolený font.
 * Displej je otočený o 180 stupňov (setRotation(2)).
 */

#include <EEPROM.h>
#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <WiFiClientSecure.h>
#include <NTPClient.h>
#include <WiFiUdp.h>
#include <Adafruit_SSD1306.h>
#include <Adafruit_GFX.h>
#include <Fonts/FreeMonoBold18pt7b.h>
#include <Fonts/FreeMonoBold12pt7b.h>
#include <time.h>

// Definícia pinov (ESP-01):
const uint8_t SDA_PIN = 0;           // I2C SDA pripojené na GPIO0
const uint8_t SCL_PIN = 2;           // I2C SCL pripojené na GPIO2
const uint8_t BUTTON_PIN = 3;        // Tlačidlo na GPIO3 (RX pin)

// Adresy v EEPROM pre konfiguračné údaje:
const int EEPROM_SIZE = 512;
const int ADDR_SSID = 0;
const int ADDR_PASS = 70;
const int ADDR_CITY = 140;
const int ADDR_TZ   = 210;  // 4 bajty (int32) pre posun časového pásma v sekundách
const int ADDR_SIGNATURE = 500;  // 4-bajtový podpis "CFG1" pre platnú konfiguráciu

// Wi-Fi a web server:
ESP8266WebServer server(80);
const char *AP_SSID = "ESP01-Setup";  // SSID Access Pointu pre konfiguračný režim

// Displej:
Adafruit_SSD1306 display(128, 64, &Wire, -1);
bool displayInitialized = false;

// Čas a počasie:
WiFiUDP ntpUDP;
NTPClient timeClient(ntpUDP);
unsigned long lastScreenSwitch = 0;
bool showWeatherScreen = false;
bool displayReady = false;
unsigned long lastWeatherFetch = 0;

// Konfiguračné premenné:
String wifiSSID = "";
String wifiPass = "";
String city = "";
int timezoneOffset = 0;  // v sekundách

// Premenné pre údaje o počasí:
String weatherTemp = "N/A";
String weatherCond = "";
String weatherHum = "";
String weatherWind = "";
String weatherPress = "";
bool weatherValid = false;

// Prototypy funkcií:
void loadSettings();
void saveSettings();
void startConfigPortal();
void handleConfigForm();
void drawTimeScreen();
void drawWeatherScreen();
bool getWeather();

void setup() {
  Serial.begin(115200);
  Serial.println();
  Serial.println(F("Booting..."));

  // Inicializácia displeja
  Wire.begin(SDA_PIN, SCL_PIN);
  if (display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    displayInitialized = true;
    display.setRotation(2);
    display.clearDisplay();
    display.setTextColor(SSD1306_WHITE);
    display.print("Booting...");
    display.display();
    displayReady = true;
  } else {
    Serial.println(F("Zlyhala inicializácia SSD1306"));
  }

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  // Inicializácia EEPROM a načítanie nastavení
  EEPROM.begin(EEPROM_SIZE);
  bool configMode = false;

  // Kontrola podpisu konfigurácie v EEPROM
  if (EEPROM.read(ADDR_SIGNATURE) == 'C' &&
      EEPROM.read(ADDR_SIGNATURE + 1) == 'F' &&
      EEPROM.read(ADDR_SIGNATURE + 2) == 'G' &&
      EEPROM.read(ADDR_SIGNATURE + 3) == '1') {
    Serial.println(F("Podpis konfigurácie nájdený v EEPROM."));
  } else {
    Serial.println(F("Podpis konfigurácie nenájdený (EEPROM prázdna)."));
  }

  // Kontrola stlačenia tlačidla počas prvých 300 ms po štarte
  bool buttonPressed = false;
  unsigned long startTime = millis();
  while (millis() - startTime < 300) {
    if (digitalRead(BUTTON_PIN) == LOW) {
      buttonPressed = true;
    }
    delay(10);
  }

  if (buttonPressed) {
    Serial.println(F("Tlačidlo podržané – vstup do konfiguračného AP režimu."));
  }

  // Určenie, či sa má spustiť konfiguračný portál
  if (EEPROM.read(ADDR_SIGNATURE) != 'C' ||
      EEPROM.read(ADDR_SIGNATURE + 1) != 'F' ||
      EEPROM.read(ADDR_SIGNATURE + 2) != 'G' ||
      EEPROM.read(ADDR_SIGNATURE + 3) != '1' ||
      buttonPressed) {
    configMode = true;
  }

  if (configMode) {
    // Načítanie existujúcich nastavení (ak existujú)
    if (EEPROM.read(ADDR_SIGNATURE) == 'C' &&
        EEPROM.read(ADDR_SIGNATURE + 1) == 'F' &&
        EEPROM.read(ADDR_SIGNATURE + 2) == 'G' &&
        EEPROM.read(ADDR_SIGNATURE + 3) == '1') {
      loadSettings();
    }
    // Spustenie konfiguračného portálu (AP režim)
    startConfigPortal();
  } else {
    // Načítanie nastavení z EEPROM
    loadSettings();
    Serial.print(F("Pripájam sa k WiFi: "));
    Serial.println(wifiSSID);

    WiFi.mode(WIFI_STA);
    WiFi.begin(wifiSSID.c_str(), wifiPass.c_str());

    // Čakanie max. 10 sekúnd na pripojenie
    unsigned long wifiStart = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - wifiStart < 10000) {
      delay(500);
      Serial.print('.');
    }
    Serial.println();

    if (WiFi.status() == WL_CONNECTED) {
      Serial.println(F("WiFi pripojené."));
      Serial.print(F("IP adresa: "));
      Serial.println(WiFi.localIP());
    } else {
      Serial.println(F("WiFi zlyhalo, spúšťam AP režim."));
      startConfigPortal();
      return;
    }

    // Nastavenie NTP klienta s uloženým časovým pásmom
    timeClient.setPoolServerName("pool.ntp.org");
    timeClient.setTimeOffset(timezoneOffset);
    timeClient.setUpdateInterval(900000);
    timeClient.begin();
    timeClient.update();

    // Prvá aktualizácia počasia
    lastWeatherFetch = 0;
    weatherValid = false;
    Serial.println(F("Setup dokončený."));
  }

  Serial.println(F("Získavam počiatočné počasie..."));
  weatherValid = getWeather();
  lastWeatherFetch = millis();
}
